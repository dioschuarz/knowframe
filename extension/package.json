{
  "name": "knowframe-vscode",
  "displayName": "KnowFrame - Knowledge Management Framework",
  "description": "KnowFrame — Knowledge Management Framework: dynamic knowledge graph, deterministic admission control, structural evolution, and BPE token economics for AI agents",
  "version": "1.0.3",
  "publisher": "dscorpsolutions",
  "repository": {
    "type": "git",
    "url": "https://github.com/dioschuarz/knowframe"
  },
  "homepage": "https://github.com/dioschuarz/knowframe#readme",
  "bugs": {
    "url": "https://github.com/dioschuarz/knowframe/issues"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0f",
    "theme": "dark"
  },
  "keywords": [
    "knowledge-graph",
    "ai-agents",
    "context-observatory",
    "markdown-notes",
    "token-budget",
    "admission-control",
    "obsidian",
    "llm-wiki"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmWiki.showKnowledgeGraph",
        "title": "KnowFrame: Show Graph",
        "category": "KnowFrame",
        "icon": "$(llm-wiki-graph)"
      },
      {
        "command": "llmWiki.setHub",
        "title": "KnowFrame: Set as Central Hub",
        "category": "KnowFrame",
        "icon": "$(target)"
      },
      {
        "command": "llmWiki.rescanVault",
        "title": "KnowFrame: Rescan Vault",
        "category": "KnowFrame",
        "icon": "$(refresh)"
      },
      {
        "command": "llmWiki.fixBrokenLinks",
        "title": "KnowFrame: Fix Broken Links",
        "category": "KnowFrame",
        "icon": "$(tools)"
      },
      {
        "command": "llmWiki.installGitHooks",
        "title": "KnowFrame: Install Git Hooks",
        "category": "KnowFrame",
        "icon": "$(source-control)"
      },
      {
        "command": "llmWiki.refreshQualityScore",
        "title": "KnowFrame: Show Knowledge Quality Score",
        "category": "KnowFrame",
        "icon": "$(dashboard)"
      },
      {
        "command": "llmWiki.reviewEvolution",
        "title": "KnowFrame: Configure Evolution & KOS",
        "category": "KnowFrame",
        "icon": "$(gear)"
      },
      {
        "command": "llmWiki.openSettings",
        "title": "KnowFrame: Open Management & Settings",
        "category": "KnowFrame",
        "icon": "$(gear)"
      },
      {
        "command": "llmWiki.openHarness",
        "title": "KnowFrame: Open AI Harness & Tooling",
        "category": "KnowFrame",
        "icon": "$(tools)"
      },
      {
        "command": "llmWiki.reviewWithAi",
        "title": "KnowFrame: Review with AI",
        "category": "KnowFrame",
        "icon": "$(tools)"
      },
      {
        "command": "llmWiki.reviewAllWithAi",
        "title": "KnowFrame: Review All with AI",
        "category": "KnowFrame",
        "icon": "$(tools)"
      },
      {
        "command": "llmWiki.restartDaemon",
        "title": "KnowFrame: Restart Knowledge Engine Daemon",
        "category": "KnowFrame",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "llmWiki.showKnowledgeGraph"
        },
        {
          "command": "llmWiki.setHub"
        },
        {
          "command": "llmWiki.rescanVault"
        },
        {
          "command": "llmWiki.fixBrokenLinks"
        },
        {
          "command": "llmWiki.installGitHooks"
        },
        {
          "command": "llmWiki.refreshQualityScore"
        },
        {
          "command": "llmWiki.reviewEvolution"
        },
        {
          "command": "llmWiki.openSettings"
        },
        {
          "command": "llmWiki.openHarness"
        },
        {
          "command": "llmWiki.reviewWithAi"
        },
        {
          "command": "llmWiki.reviewAllWithAi"
        },
        {
          "command": "llmWiki.restartDaemon"
        }
      ],
      "editor/title": [
        {
          "command": "llmWiki.showKnowledgeGraph",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "llmWiki.rescanVault",
          "when": "view == llmWiki.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "llmWiki.openSettings",
          "when": "view == llmWiki.sidebarView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llm-wiki-sidebar",
          "title": "KnowFrame - Manager",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "llm-wiki-sidebar": [
        {
          "type": "webview",
          "id": "llmWiki.sidebarView",
          "name": "KnowFrame - Manager"
        }
      ]
    },
    "icons": {
      "llm-wiki-graph": {
        "description": "KnowFrame Graph Icon",
        "default": {
          "fontPath": "./media/llm-wiki-icons.woff",
          "fontCharacter": "\\f101"
        }
      }
    },
    "configuration": {
      "title": "KnowFrame",
      "properties": {
        "llmWiki.daemonPort": {
          "type": "number",
          "default": 0,
          "description": "Daemon listening port (0 for OS-assigned ephemeral port)"
        },
        "llmWiki.gitHookEngine": {
          "type": "string",
          "enum": [
            "prek",
            "pre-commit",
            "script"
          ],
          "default": "prek",
          "description": "Git hook orchestrator preference"
        },
        "llmWiki.tokenBudgetWarning": {
          "type": "number",
          "default": 60000,
          "description": "Warning threshold for Active Prompt Load tokens"
        },
        "llmWiki.tokenBudgetCritical": {
          "type": "number",
          "default": 100000,
          "description": "Critical threshold for Active Prompt Load tokens"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "build:rust": "cargo build --release --manifest-path ../Cargo.toml && cp ../target/release/knowframe-core bin/ && cp ../target/release/knowframe-cli bin/",
    "vsix": "npm run build:rust && npm run package && npx --yes @vscode/vsce package --no-dependencies -o knowframe-1.0.3.vsix",
    "reinstall": "bash ../scripts/distribute.sh",
    "distribute": "bash ../scripts/distribute.sh",
    "package:verify": "npm run package && node -e \"const fs = require('fs'); const file = fs.existsSync('knowframe-1.0.3.vsix') ? 'knowframe-1.0.3.vsix' : 'knowframe-1.0.2.vsix'; const st = fs.statSync(file); console.log('VSIX size: ' + (st.size / (1024*1024)).toFixed(2) + ' MB'); if(st.size > 25*1024*1024) { console.error('VSIX exceeds 25MB budget'); process.exit(1); }\"",
    "lint": "eslint src --ext ts",
    "test": "node --test --experimental-strip-types test/suite/*.test.ts",
    "test:e2e": "node --test --experimental-strip-types test/suite/evolution.e2e.test.ts",
    "dev": "code --user-data-dir=/tmp/vscode-dev-profile --extensionDevelopmentPath=${PWD} /home/ds/projects",
    "launch-dev": "code --user-data-dir=/tmp/vscode-dev-profile --extensionDevelopmentPath=${PWD} /home/ds/projects"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "ws": "^8.17.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  }
}