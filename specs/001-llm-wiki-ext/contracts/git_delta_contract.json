{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHookDeltaNotification",
  "description": "JSON-RPC 2.0 notification emitted by llm-wiki-core git-delta CLI command to the background sidecar daemon",
  "type": "object",
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "method": { "const": "git/commitDelta" },
    "params": {
      "type": "object",
      "properties": {
        "repo_path": { "type": "string" },
        "commit_hash": { "type": "string" },
        "branch": { "type": "string" },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["added", "modified", "deleted"]
              }
            },
            "required": ["path", "status"]
          }
        }
      },
      "required": ["repo_path", "changed_files"]
    }
  },
  "required": ["jsonrpc", "method", "params"]
}
